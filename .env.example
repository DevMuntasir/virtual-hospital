# Clinical chat, reports and speech: gemini | openai
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-3.8-flash
OPENAI_MODEL=GPT-Live-1

# Only the selected provider requires a key.
GEMINI_API_KEY=your-gemini-api-key
# Also used independently for optional OpenAI live transcription.
OPENAI_API_KEY=your-openai-api-key

# Gemini speech model is separate from the text model.
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Charon
